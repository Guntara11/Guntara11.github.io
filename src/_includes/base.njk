<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.name }} — {{ site.role }}{% endif %}</title>
<meta name="description" content="{{ description or subtitle or site.description }}">
<meta property="og:title" content="{{ title or site.name }}">
<meta property="og:description" content="{{ description or subtitle or site.description }}">
<meta property="og:type" content="website">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="{{ '/assets/style.css' | url }}">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='%232f6f9f'/><path d='M5 20 L11 20 L11 11 L17 11 L17 22 L23 22 L23 14 L27 14' fill='none' stroke='white' stroke-width='2.4'/></svg>">
</head>
<body>
<header class="site-head wrap">
  <a class="name" href="{{ '/' | url }}">{{ site.name }}</a>
  <nav>
    <a href="{{ '/' | url }}"{% if page.url == '/' %} aria-current="page"{% endif %}>Projects</a>
    <a href="{{ '/about/' | url }}"{% if page.url == '/about/' %} aria-current="page"{% endif %}>About</a>
    <a href="{{ '/assets/ega-guntara-cv.pdf' | url }}">CV</a>
    <a href="{{ site.github }}">GitHub</a>
    <a href="{{ site.linkedin }}">LinkedIn</a>
  </nav>
</header>

<main class="wrap">
{{ content | safe }}
</main>

<footer class="site-foot wrap">
  <div>{{ site.name }} — {{ site.role }}, {{ site.location }}.</div>
  <div><a href="mailto:{{ site.email }}">{{ site.email }}</a></div>
</footer>
</body>
</html>
