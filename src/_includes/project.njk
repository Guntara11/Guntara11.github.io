---
layout: base.njk
---
<article>
  <div class="project-head">
    <h1>{{ title }}</h1>
    <p class="lede">{{ subtitle }}</p>
  </div>

  <div class="spec">
    <dl>
      <dt>Problem</dt><dd>{{ problem }}</dd>
      <dt>What I built</dt><dd>{{ built }}</dd>
      <dt>Result</dt><dd>{{ result }}</dd>
      <dt>Context</dt>
      <dd>
        <div class="fact"><span>{{ role }}</span><span>{{ client }}</span><span>{{ year }}</span></div>
        <ul class="chips" style="margin-top:.6rem">
          {% for item in stack %}<li>{{ item }}</li>{% endfor %}
        </ul>
      </dd>
    </dl>
  </div>

  <div class="prose">
    {{ content | safe }}
  </div>
</article>

{% set projects = collections.projects %}
{% set idx = null %}
{% for p in projects %}{% if p.url == page.url %}{% set idx = loop.index0 %}{% endif %}{% endfor %}
<nav class="pager">
  <div>
    {% if idx > 0 %}
      {% set prev = projects[idx - 1] %}
      <span>Previous</span><a href="{{ prev.url | url }}">{{ prev.data.title }}</a>
    {% endif %}
  </div>
  <div style="text-align:right">
    {% if idx < projects.length - 1 %}
      {% set next = projects[idx + 1] %}
      <span>Next</span><a href="{{ next.url | url }}">{{ next.data.title }}</a>
    {% endif %}
  </div>
</nav>
